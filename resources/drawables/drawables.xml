<?xml version="1.0" encoding="UTF-8"?>
<drawables>
    <!-- LauncherIcon is declared per-size in resources-launcher-<N>/drawables.xml
         (generated from icons/launcher_master.svg) and wired per device in
         monkey.jungle. Only shared, size-independent drawables live here. -->

    <!-- Glance -->
    <bitmap id="GlanceError" filename="close-circle-outline.svg" scaleX="6%" scaleY="6%" automaticPalette="false" scope="glance" />
    <bitmap id="GlanceInfo" filename="information-outline.svg" scaleX="6%" scaleY="6%" automaticPalette="false" scope="glance" />
    <bitmap id="GlanceLightsAll" filename="lightbulb-group.svg" scaleX="6%" scaleY="6%" automaticPalette="false" scope="glance" />
    <bitmap id="GlanceLightsSome" filename="lightbulb-group-outline.svg" scaleX="6%" scaleY="6%" automaticPalette="false" scope="glance" />
    <bitmap id="GlanceThermometer" filename="thermometer.svg" scaleX="6%" scaleY="6%" automaticPalette="false" scope="glance" />
    <bitmap id="GlanceHumidity" filename="water-percent.svg" scaleX="6%" scaleY="6%" automaticPalette="false" scope="glance" />

    <!-- Icons -->
    <bitmap id="LightbulbGroupSome" filename="lightbulb-group-outline.svg" scaleX="16%" scaleY="16%" automaticPalette="false" />
    <bitmap id="LightbulbGroupAll" filename="lightbulb-group.svg" scaleX="16%" scaleY="16%" automaticPalette="false" />
    <bitmap id="LightbulbOn" filename="lightbulb-on.svg" scaleX="12%" scaleY="12%" automaticPalette="false" />
    <bitmap id="LightbulbOff" filename="lightbulb-outline.svg" scaleX="10%" scaleY="10%" automaticPalette="false" />
    <bitmap id="LightbulbUnavailable" filename="lightbulb-off-outline.svg" scaleX="10%" scaleY="10%" automaticPalette="false" />
    <bitmap id="Temperature" filename="thermometer.svg" scaleX="6%" scaleY="6%" automaticPalette="false" />
    <bitmap id="Humidity" filename="water-percent.svg" scaleX="6%" scaleY="6%" automaticPalette="false" />
    <bitmap id="Brightness" filename="brightness-5.svg" scaleX="6%" scaleY="6%" automaticPalette="false" />

    <!-- UI -->
    <bitmap id="SelectHint" personality="system_icon_dark__hint_button_right_top system_loc__hint_button_right_top" />
</drawables>
